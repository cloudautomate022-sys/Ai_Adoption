# URL of the FastAPI backend (no trailing slash).
#
# API_URL is read by the Next.js server at runtime: change it in Render/Vercel
# and restart the service — no rebuild required. This is the recommended way
# to point the frontend at a backend hosted somewhere other than localhost:8000.
#
# End users can also change the backend URL graphically from the "API" button
# in the header. That browser preference overrides this variable.
API_URL=http://localhost:8000

# Build-time fallback (optional). Use it only for static hosting, because it is
# embedded in the bundle during `next build`.
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
