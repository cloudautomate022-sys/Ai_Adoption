# Copy to backend/.env and edit before deploying.

# Runtime / deployment
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
# Public URL of this backend. Render sets RENDER_EXTERNAL_URL automatically;
# set this when using a custom domain or another host.
# PUBLIC_API_URL=https://ia-day-0-api.onrender.com
# Optional reverse-proxy prefix, e.g. /ia-day-0
# ROOT_PATH=

# Auth — CHANGE THESE IN PRODUCTION
SECRET_KEY=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CloudAutomate2026!
TOKEN_TTL_HOURS=12

# Data (SQLite for local/demo; use the Render Postgres URL in production)
DATABASE_URL=sqlite:///./data/ia_day0.db
# DATABASE_URL=postgresql://user:password@host:5432/database

# CORS. Add the deployed frontend origin(s), comma separated. Entries without
# a scheme are treated as HTTPS (Render service hosts work as-is).
# Common hosting domains (*.onrender.com, *.vercel.app, *.netlify.app) are
# allowed by default; add your custom domain here.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Optional regex for preview deployments, e.g.:
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
